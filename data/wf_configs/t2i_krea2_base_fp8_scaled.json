{
  "workflow": "t2i_krea2_base_fp8_scaled.json",
  "display_name": "Krea 2 Base FP8 Scaled 文生图",
  "description": "Krea 2 Raw/Base workflow. Comfy-Org/Krea-2 currently has no Raw/Base MXFP8 file, so this uses the official Raw FP8 Scaled single-file diffusion model.",
  "required_models": [
    "diffusion_models/krea2_raw_fp8_scaled.safetensors",
    "text_encoders/qwen3vl_4b_fp8_scaled.safetensors",
    "vae/qwen_image_vae.safetensors"
  ],
  "fields": [
    {
      "key": "6::text",
      "zone": "user_input",
      "visible": true,
      "label": "提示词",
      "order": 0,
      "type": "textarea"
    },
    {
      "key": "10::width",
      "zone": "user_input",
      "visible": true,
      "label": "宽度",
      "order": 1,
      "type": "number",
      "role": "width",
      "step": 64,
      "min": 512,
      "max": 1024
    },
    {
      "key": "10::height",
      "zone": "user_input",
      "visible": true,
      "label": "高度",
      "order": 2,
      "type": "number",
      "role": "height",
      "step": 64,
      "min": 512,
      "max": 1024
    },
    {
      "key": "2::seed",
      "zone": "advanced",
      "visible": true,
      "label": "种子",
      "order": 0,
      "type": "seed"
    },
    {
      "key": "2::steps",
      "zone": "advanced",
      "visible": true,
      "label": "步数",
      "order": 1,
      "type": "number",
      "min": 1,
      "max": 80
    },
    {
      "key": "2::cfg",
      "zone": "advanced",
      "visible": true,
      "label": "CFG",
      "order": 2,
      "type": "number",
      "step": 0.1,
      "min": 0,
      "max": 10
    },
    {
      "key": "5::filename_prefix",
      "zone": "output",
      "visible": true,
      "label": "文件名前缀",
      "order": 0,
      "type": "text"
    },
    {
      "key": "2::sampler_name",
      "zone": "hidden",
      "visible": false,
      "label": "采样器",
      "order": 0,
      "type": "select",
      "options": [
        "euler",
        "er_sde",
        "dpmpp_2m",
        "res_multistep",
        "uni_pc"
      ]
    },
    {
      "key": "2::scheduler",
      "zone": "hidden",
      "visible": false,
      "label": "调度器",
      "order": 2,
      "type": "select",
      "options": [
        "simple",
        "normal",
        "karras",
        "beta"
      ]
    },
    {
      "key": "8::text",
      "zone": "hidden",
      "visible": false,
      "label": "负面提示词",
      "order": 1,
      "type": "textarea"
    },
    {
      "key": "2::denoise",
      "zone": "hidden",
      "visible": false,
      "label": "降噪",
      "order": 3,
      "type": "number",
      "step": 0.01,
      "min": 0,
      "max": 1
    },
    {
      "key": "1::unet_name",
      "zone": "hidden",
      "visible": false,
      "label": "Krea 2 Base 模型",
      "order": 4,
      "type": "text"
    },
    {
      "key": "1::weight_dtype",
      "zone": "hidden",
      "visible": false,
      "label": "weight_dtype",
      "order": 5,
      "type": "text"
    },
    {
      "key": "4::vae_name",
      "zone": "hidden",
      "visible": false,
      "label": "vae_name",
      "order": 6,
      "type": "text"
    },
    {
      "key": "10::batch_size",
      "zone": "hidden",
      "visible": false,
      "label": "batch_size",
      "order": 7,
      "type": "number"
    },
    {
      "key": "13::clip_name",
      "zone": "hidden",
      "visible": false,
      "label": "clip_name",
      "order": 8,
      "type": "text"
    },
    {
      "key": "13::type",
      "zone": "hidden",
      "visible": false,
      "label": "type",
      "order": 9,
      "type": "text"
    },
    {
      "key": "13::device",
      "zone": "hidden",
      "visible": false,
      "label": "device",
      "order": 10,
      "type": "text"
    }
  ],
  "notes": "Comfy-Org/Krea-2 currently exposes krea2_raw_fp8_scaled.safetensors but no krea2_raw_mxfp8.safetensors. Krea 2 Raw/Base follows official inference at 52 steps, CFG 3.5, Euler flow sampling, empty negative prompt encoding, and up to 1024px."
}