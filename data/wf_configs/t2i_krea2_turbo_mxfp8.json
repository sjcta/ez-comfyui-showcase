{
  "workflow": "t2i_krea2_turbo_mxfp8.json",
  "display_name": "Krea 2 Turbo MXFP8 文生图",
  "description": "Krea 2 Turbo MXFP8 workflow using Comfy-Org/Krea-2 and the native ComfyUI Krea2 loader contract.",
  "required_models": [
    "diffusion_models/krea2_turbo_mxfp8.safetensors",
    "text_encoders/qwen3vl_4b_fp8_scaled.safetensors",
    "vae/qwen_image_vae.safetensors"
  ],
  "fields": [
    {
      "key": "6::text",
      "zone": "user_input",
      "visible": true,
      "label": "提示词",
      "order": 0,
      "type": "textarea"
    },
    {
      "key": "10::width",
      "zone": "user_input",
      "visible": true,
      "label": "宽度",
      "order": 1,
      "type": "number",
      "role": "width",
      "step": 64,
      "min": 512,
      "max": 2048
    },
    {
      "key": "10::height",
      "zone": "user_input",
      "visible": true,
      "label": "高度",
      "order": 2,
      "type": "number",
      "role": "height",
      "step": 64,
      "min": 512,
      "max": 2048
    },
    {
      "key": "2::seed",
      "zone": "advanced",
      "visible": true,
      "label": "种子",
      "order": 0,
      "type": "seed"
    },
    {
      "key": "2::steps",
      "zone": "advanced",
      "visible": true,
      "label": "步数",
      "order": 1,
      "type": "number",
      "min": 1,
      "max": 16
    },
    {
      "key": "2::cfg",
      "zone": "hidden",
      "visible": false,
      "label": "CFG",
      "order": 2,
      "type": "number",
      "step": 0.1,
      "min": 1,
      "max": 4
    },
    {
      "key": "5::filename_prefix",
      "zone": "output",
      "visible": true,
      "label": "文件名前缀",
      "order": 0,
      "type": "text"
    },
    {
      "key": "2::sampler_name",
      "zone": "hidden",
      "visible": false,
      "label": "采样器",
      "order": 0,
      "type": "select",
      "options": [
        "euler",
        "er_sde",
        "dpmpp_2m",
        "res_multistep",
        "uni_pc"
      ]
    },
    {
      "key": "2::scheduler",
      "zone": "hidden",
      "visible": false,
      "label": "调度器",
      "order": 2,
      "type": "select",
      "options": [
        "simple",
        "normal",
        "karras",
        "beta"
      ]
    },
    {
      "key": "8::text",
      "zone": "hidden",
      "visible": false,
      "label": "负面提示词",
      "order": 1,
      "type": "textarea"
    },
    {
      "key": "2::denoise",
      "zone": "hidden",
      "visible": false,
      "label": "降噪",
      "order": 3,
      "type": "number",
      "step": 0.01,
      "min": 0,
      "max": 1
    },
    {
      "key": "1::unet_name",
      "zone": "hidden",
      "visible": false,
      "label": "Krea 2 Turbo 模型",
      "order": 4,
      "type": "text"
    },
    {
      "key": "1::weight_dtype",
      "zone": "hidden",
      "visible": false,
      "label": "weight_dtype",
      "order": 5,
      "type": "text"
    },
    {
      "key": "4::vae_name",
      "zone": "hidden",
      "visible": false,
      "label": "vae_name",
      "order": 6,
      "type": "text"
    },
    {
      "key": "10::batch_size",
      "zone": "hidden",
      "visible": false,
      "label": "batch_size",
      "order": 7,
      "type": "number"
    },
    {
      "key": "13::clip_name",
      "zone": "hidden",
      "visible": false,
      "label": "clip_name",
      "order": 8,
      "type": "text"
    },
    {
      "key": "13::type",
      "zone": "hidden",
      "visible": false,
      "label": "type",
      "order": 9,
      "type": "text"
    },
    {
      "key": "13::device",
      "zone": "hidden",
      "visible": false,
      "label": "device",
      "order": 10,
      "type": "text"
    }
  ],
  "notes": "Krea 2 official inference recommends Turbo at 8 steps, CFG disabled, Mu 1.15, and 1024-2048px. In ComfyUI KSampler, official CFG-disabled/cond-only behavior maps to cfg=1, not cfg=0; cfg=0 produces uncond/negative-side noise. Mu/shift is provided by the native Krea2 model config in ComfyUI, Euler matches the official flow ODE sampler, and the negative branch is an empty CLIPTextEncode rather than ConditioningZeroOut."
}